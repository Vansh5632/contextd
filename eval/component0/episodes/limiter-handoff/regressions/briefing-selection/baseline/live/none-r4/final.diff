         )
 
 
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_connections", [1, 2])
+async def test_connection_pool_limit_with_idle_connections(max_connections):
+    network_backend = httpcore.AsyncMockBackend(
+        [b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nHello"]
+    )
+    async with httpcore.AsyncConnectionPool(
+        max_connections=max_connections, network_backend=network_backend
+    ) as pool:
+        for index in range(max_connections):
+            response = await pool.request("GET", f"https://{index}.example.com/")
+            assert response.content == b"Hello"
+
+        evicted_connection = pool.connections[0]
+        async with pool.stream("GET", "https://new.example.com/") as response:
+            assert len(pool.connections) == max_connections
+            assert evicted_connection not in pool.connections
+            assert evicted_connection.is_closed()
+            assert await response.aread() == b"Hello"
+
