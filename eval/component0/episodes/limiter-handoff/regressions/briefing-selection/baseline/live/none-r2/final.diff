         )
 
 
+@pytest.mark.anyio
+async def test_connection_pool_replaces_idle_connection_at_capacity():
+    network_backend = httpcore.AsyncMockBackend(
+        [b"HTTP/1.1 200 OK\r\nContent-Length: 13\r\n\r\nHello, world!"]
+    )
+
+    async with httpcore.AsyncConnectionPool(
+        max_connections=2, network_backend=network_backend
+    ) as pool:
+        await pool.request("GET", "https://a.example.com/")
+        first_connection = pool.connections[0]
+        await pool.request("GET", "https://b.example.com/")
+        second_connection = pool.connections[1]
+
+        async with pool.stream("GET", "https://c.example.com/") as response:
+            assert len(pool.connections) == 2
+            assert first_connection not in pool.connections
+            assert first_connection.is_closed()
+            assert second_connection in pool.connections
+            assert second_connection.is_idle()
+            assert await response.aread() == b"Hello, world!"
+
